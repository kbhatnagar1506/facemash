{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://35-188-1-8.sslip.io/api/:path*"
    },
    {
      "source": "/avatar",
      "destination": "/index.html"
    },
    {
      "source": "/play",
      "destination": "/index.html"
    },
    {
      "source": "/muse",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
